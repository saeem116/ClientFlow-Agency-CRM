# Database (MongoDB)
# Use a local instance for development, or a MongoDB Atlas cluster.
# Never commit the actual connection string.
MONGODB_URI="mongodb://localhost:27017/clientflow"

# For test runs (vitest). Must NOT point at the production database.
TEST_MONGODB_URI="mongodb://localhost:27017/clientflow-test"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Authentication ───────────────────────────────────────────────────────────
# A cryptographically random 256-bit secret used to sign session tokens with
# HMAC-SHA256. Every deployment must use its own unique secret — a shared or
# example secret lets anyone forge valid session tokens.
#
# Generate a fresh secret for your environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The value below is intentionally left blank. You MUST set a unique secret
# for every deployment. A missing or placeholder secret will cause the
# application to fail closed at runtime.
AUTH_SECRET=

# Admin access (email-based)
# Only this email can access /admin/users and manage invitations.
ADMIN_EMAIL="admin@example.com"

# Email (SMTP)
# For Gmail, create an App Password: https://support.google.com/accounts/answer/185833
# Remove these lines or comment them out if you do not need invitation emails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="ClientFlow <your-email@gmail.com>"

# Optional: absolute base URL for avatar images served by /api/avatars/[userId].
# Required when using next/image outside the same origin (e.g. Vercel deployment).
# NEXT_PUBLIC_AVATAR_BASE_URL="https://your-domain.vercel.app"

# (Optional) Test credentials used by Playwright e2e tests.
# TEST_USER_EMAIL="test@example.com"
# TEST_USER_PASSWORD="password123"

# ── Public Demo Accounts (Vibe96 submission) ──────────────────────────────
# Set DEMO_MONGODB_URI to enable demo accounts on the SAME deployed URL as
# production. Demo accounts authenticate against a SEPARATE database named
# exactly "clientflow_demo" — never the production database.
#
# DEMO_MONGODB_URI="mongodb://localhost:27017/clientflow_demo"
#
# Reviewer demo account (public, read-only MEMBER role)
# Default: reviewer@clientflow.test
# DEMO_ACCOUNT_EMAIL="reviewer@clientflow.test"
#
# Admin demo account (configured per-deployment, ADMIN role)
# Must be explicitly provisioned in the demo database before use.
# Default: admin@demo.test
# DEMO_ADMIN_EMAIL="admin@demo.test"
#
# Team Member demo login button (falls back to DEMO_ACCOUNT_EMAIL)
# DEMO_MEMBER_EMAIL="reviewer@clientflow.test"
#
# Seed the demo database (reviewer account + demo data):
#   CONFIRM_DEMO_SEED=YES \
#   DEMO_SEED_MONGODB_URI=mongodb://localhost:27017/clientflow_demo \
#   DEMO_REVIEWER_PASSWORD="<your-strong-password>" \
#   node scripts/seed-demo-public.js
#
# Provision the admin demo account (idempotent, safe to re-run):
#   CONFIRM_DEMO_PROVISION=YES \
#   DEMO_PROVISION_MONGODB_URI=mongodb://localhost:27017/clientflow_demo \
#   DEMO_ADMIN_EMAIL="admin@demo.test" \
#   node scripts/provision-demo-admin.js
#
# After provisioning, set DEMO_ADMIN_EMAIL in Vercel to the provisioned email.
# The script will print the generated password to stdout — set it as
# DEMO_ADMIN_PASSWORD in Vercel if using password-based demo login.